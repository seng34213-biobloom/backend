generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BatchStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  DEPLETED
}

enum AuditActorType {
  ADMIN
  SELLER
  SYSTEM
  CUSTOMER
}

enum Role {
  CUSTOMER
  ADMIN
  FULFILMENT_STAFF
  SELLER
  DELIVERY
}

enum AdminRole {
  ADMIN
  FULFILMENT_STAFF
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model Customer {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  phone        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@map("customer")
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  role         AdminRole @default(FULFILMENT_STAFF)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  auditLogs AuditLog[]

  @@index([email])
  @@map("admin_user")
}

model Seller {
  id                String       @id @default(uuid()) @db.Uuid
  email             String       @unique
  passwordHash      String       @map("password_hash")
  businessName      String       @map("business_name")
  contactName       String       @map("contact_name")
  phone             String
  taxId             String?      @map("tax_id")
  status            SellerStatus @default(PENDING)
  approvedAt        DateTime?    @map("approved_at")
  approvedByAdminId String?      @map("approved_by_admin_id") @db.Uuid
  rejectionReason   String?      @map("rejection_reason")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  products Product[]

  @@index([status])
  @@map("seller")
}

model DeliveryUser {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  phone        String
  fcmToken     String?  @map("fcm_token")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("delivery_user")
}

// Append-only record of privileged changes (SDS §7.2). actorId only links to admin users;
// seller, customer and system actions keep their actor ID in metadata.
model AuditLog {
  id         String         @id @default(uuid()) @db.Uuid
  actorType  AuditActorType @map("actor_type")
  actorId    String?        @map("actor_id") @db.Uuid
  action     String
  targetType String         @map("target_type")
  targetId   String?        @map("target_id")
  metadata   Json?
  ipAddress  String?        @map("ip_address")
  userAgent  String?        @map("user_agent")
  createdAt  DateTime       @default(now()) @map("created_at")

  adminUser AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorType, actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_log")
}

model Product {
  id              String   @id @default(uuid()) @db.Uuid
  // Owning seller; null for products managed directly by Bio Bloom admins
  sellerId        String?  @map("seller_id") @db.Uuid
  name            String
  slug            String   @unique
  description     String
  basePrice       Decimal  @map("base_price") @db.Decimal(12, 2)
  // Default unit weight; each variant also stores its own weight for shipping
  unitWeightGrams Int      @map("unit_weight_grams")
  category        String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  seller   Seller?          @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  variants ProductVariant[]

  @@index([sellerId])
  @@index([category, active])
  @@map("product")
}

model ProductVariant {
  id              String   @id @default(uuid()) @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  sku             String   @unique
  name            String
  size            String
  price           Decimal  @db.Decimal(12, 2)
  // Used by the weight-based shipping calculation
  unitWeightGrams Int      @map("unit_weight_grams")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  batches ProductBatch[]

  @@index([productId])
  @@map("product_variant")
}

// Quantity and date rules are enforced with CHECK constraints in the migration SQL.
model ProductBatch {
  id               String      @id @default(uuid()) @db.Uuid
  productVariantId String      @map("product_variant_id") @db.Uuid
  batchNumber      String      @map("batch_number")
  manufacturedDate DateTime    @map("manufactured_date") @db.Date
  expiryDate       DateTime    @map("expiry_date") @db.Date
  initialQuantity  Int         @map("initial_quantity")
  currentQuantity  Int         @map("current_quantity")
  status           BatchStatus @default(ACTIVE)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([productVariantId, batchNumber])
  // FIFO selection: oldest-expiring batches of a variant first
  @@index([productVariantId, expiryDate])
  @@index([expiryDate])
  @@map("product_batch")
}
