generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BatchStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  DEPLETED
}

enum AuditActorType {
  ADMIN
  SELLER
  SYSTEM
  CUSTOMER
}

enum Role {
  CUSTOMER
  ADMIN
  FULFILMENT_STAFF
  SELLER
  DELIVERY
}

enum AdminRole {
  ADMIN
  FULFILMENT_STAFF
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum PaymentGateway {
  STRIPE
  PAYHERE
}

model Customer {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  phone        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  addresses     Address[]
  subscriptions Subscription[]
  cartItems     CartItem[]

  @@index([email])
  @@map("customer")
}

model Address {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  line1      String
  line2      String?
  city       String
  district   String
  postalCode String   @map("postal_code")
  country    String   @default("LK") @db.Char(2)
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@index([customerId])
  @@map("address")
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  role         AdminRole @default(FULFILMENT_STAFF)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  auditLogs AuditLog[]

  @@index([email])
  @@map("admin_user")
}

model Seller {
  id                String       @id @default(uuid()) @db.Uuid
  email             String       @unique
  passwordHash      String       @map("password_hash")
  businessName      String       @map("business_name")
  contactName       String       @map("contact_name")
  phone             String
  taxId             String?      @map("tax_id")
  status            SellerStatus @default(PENDING)
  approvedAt        DateTime?    @map("approved_at")
  approvedByAdminId String?      @map("approved_by_admin_id") @db.Uuid
  rejectionReason   String?      @map("rejection_reason")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  products Product[]

  @@index([status])
  @@map("seller")
}

model DeliveryUser {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  phone        String
  fcmToken     String?  @map("fcm_token")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("delivery_user")
}

// Append-only record of privileged changes (SDS §7.2). actorId only links to admin users;
// seller, customer and system actions keep their actor ID in metadata.
model AuditLog {
  id         String         @id @default(uuid()) @db.Uuid
  actorType  AuditActorType @map("actor_type")
  actorId    String?        @map("actor_id") @db.Uuid
  action     String
  targetType String         @map("target_type")
  targetId   String?        @map("target_id")
  metadata   Json?
  ipAddress  String?        @map("ip_address")
  userAgent  String?        @map("user_agent")
  createdAt  DateTime       @default(now()) @map("created_at")

  adminUser AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorType, actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_log")
}

model Product {
  id              String   @id @default(uuid()) @db.Uuid
  // Owning seller; null for products managed directly by Bio Bloom admins
  sellerId        String?  @map("seller_id") @db.Uuid
  name            String
  slug            String   @unique
  description     String
  basePrice       Decimal  @map("base_price") @db.Decimal(12, 2)
  // Default unit weight; each variant also stores its own weight for shipping
  unitWeightGrams Int      @map("unit_weight_grams")
  category        String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  seller   Seller?          @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  variants ProductVariant[]

  @@index([sellerId])
  @@index([category, active])
  @@map("product")
}

model ProductVariant {
  id              String   @id @default(uuid()) @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  sku             String   @unique
  name            String
  size            String
  price           Decimal  @db.Decimal(12, 2)
  // Used by the weight-based shipping calculation
  unitWeightGrams Int      @map("unit_weight_grams")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  batches       ProductBatch[]
  subscriptions Subscription[]
  cartItems     CartItem[]

  @@index([productId])
  @@map("product_variant")
}

// Quantity and date rules are enforced with CHECK constraints in the migration SQL.
model ProductBatch {
  id               String      @id @default(uuid()) @db.Uuid
  productVariantId String      @map("product_variant_id") @db.Uuid
  batchNumber      String      @map("batch_number")
  manufacturedDate DateTime    @map("manufactured_date") @db.Date
  expiryDate       DateTime    @map("expiry_date") @db.Date
  initialQuantity  Int         @map("initial_quantity")
  currentQuantity  Int         @map("current_quantity")
  status           BatchStatus @default(ACTIVE)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([productVariantId, batchNumber])
  // FIFO selection: oldest-expiring batches of a variant first
  @@index([productVariantId, expiryDate])
  @@index([expiryDate])
  @@map("product_batch")
}

// The payment token is stored encrypted with pgcrypto (pgp_sym_encrypt); see TokenCipherService.
// Frequency, quantity and discount rules are enforced with CHECK constraints in the migration SQL.
model Subscription {
  id                    String             @id @default(uuid()) @db.Uuid
  customerId            String             @map("customer_id") @db.Uuid
  productVariantId      String             @map("product_variant_id") @db.Uuid
  shippingAddressId     String             @map("shipping_address_id") @db.Uuid
  frequencyDays         Int                @map("frequency_days")
  discountRate          Decimal            @map("discount_rate") @db.Decimal(5, 4)
  quantity              Int                @default(1)
  status                SubscriptionStatus @default(ACTIVE)
  nextBillingDate       DateTime           @map("next_billing_date") @db.Date
  paymentTokenEncrypted Bytes              @map("payment_token_encrypted")
  paymentGateway        PaymentGateway     @map("payment_gateway")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  cancelledAt           DateTime?          @map("cancelled_at")

  customer        Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  variant         ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  shippingAddress Address        @relation(fields: [shippingAddressId], references: [id], onDelete: Restrict)

  // The daily billing job selects due ACTIVE subscriptions
  @@index([status, nextBillingDate])
  @@index([customerId])
  @@map("subscription")
}

model CartItem {
  id               String   @id @default(uuid()) @db.Uuid
  customerId       String   @map("customer_id") @db.Uuid
  productVariantId String   @map("product_variant_id") @db.Uuid
  quantity         Int
  addedAt          DateTime @default(now()) @map("added_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([customerId, productVariantId])
  @@index([customerId])
  @@map("cart_item")
}
