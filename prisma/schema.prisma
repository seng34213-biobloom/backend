generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BatchStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  DEPLETED
}

enum AuditActorType {
  ADMIN
  SELLER
  SYSTEM
  CUSTOMER
}

enum Role {
  CUSTOMER
  ADMIN
  FULFILMENT_STAFF
  SELLER
  DELIVERY
}

enum AdminRole {
  ADMIN
  FULFILMENT_STAFF
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum PaymentGateway {
  STRIPE
  PAYHERE
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PACKING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSED
}

enum ReviewStatus {
  PENDING
  APPROVED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Customer {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  phone        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  addresses      Address[]
  subscriptions  Subscription[]
  cartItems      CartItem[]
  orders         Order[]
  refundRequests RefundRequest[]
  reviews        ProductReview[]
  supportTickets SupportTicket[]

  @@index([email])
  @@map("customer")
}

model Address {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  line1      String
  line2      String?
  city       String
  district   String
  postalCode String   @map("postal_code")
  country    String   @default("LK") @db.Char(2)
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  orders        Order[]

  @@index([customerId])
  @@map("address")
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  role         AdminRole @default(FULFILMENT_STAFF)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  auditLogs AuditLog[]

  @@index([email])
  @@map("admin_user")
}

model Seller {
  id                String       @id @default(uuid()) @db.Uuid
  email             String       @unique
  passwordHash      String       @map("password_hash")
  businessName      String       @map("business_name")
  contactName       String       @map("contact_name")
  phone             String
  taxId             String?      @map("tax_id")
  status            SellerStatus @default(PENDING)
  approvedAt        DateTime?    @map("approved_at")
  approvedByAdminId String?      @map("approved_by_admin_id") @db.Uuid
  rejectionReason   String?      @map("rejection_reason")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  products Product[]

  @@index([status])
  @@map("seller")
}

model DeliveryUser {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  phone        String
  fcmToken     String?  @map("fcm_token")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("delivery_user")
}

// Append-only record of privileged changes (SDS §7.2). actorId only links to admin users;
// seller, customer and system actions keep their actor ID in metadata.
model AuditLog {
  id         String         @id @default(uuid()) @db.Uuid
  actorType  AuditActorType @map("actor_type")
  actorId    String?        @map("actor_id") @db.Uuid
  action     String
  targetType String         @map("target_type")
  targetId   String?        @map("target_id")
  metadata   Json?
  ipAddress  String?        @map("ip_address")
  userAgent  String?        @map("user_agent")
  createdAt  DateTime       @default(now()) @map("created_at")

  adminUser AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorType, actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_log")
}

model Product {
  id              String   @id @default(uuid()) @db.Uuid
  // Owning seller; null for products managed directly by Bio Bloom admins
  sellerId        String?  @map("seller_id") @db.Uuid
  name            String
  slug            String   @unique
  description     String
  basePrice       Decimal  @map("base_price") @db.Decimal(12, 2)
  // Default unit weight; each variant also stores its own weight for shipping
  unitWeightGrams Int      @map("unit_weight_grams")
  category        String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  seller   Seller?          @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  variants ProductVariant[]
  reviews  ProductReview[]

  @@index([sellerId])
  @@index([category, active])
  @@map("product")
}

model ProductVariant {
  id              String   @id @default(uuid()) @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  sku             String   @unique
  name            String
  size            String
  price           Decimal  @db.Decimal(12, 2)
  // Used by the weight-based shipping calculation
  unitWeightGrams Int      @map("unit_weight_grams")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  batches       ProductBatch[]
  subscriptions Subscription[]
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@index([productId])
  @@map("product_variant")
}

// Quantity and date rules are enforced with CHECK constraints in the migration SQL.
model ProductBatch {
  id               String      @id @default(uuid()) @db.Uuid
  productVariantId String      @map("product_variant_id") @db.Uuid
  batchNumber      String      @map("batch_number")
  manufacturedDate DateTime    @map("manufactured_date") @db.Date
  expiryDate       DateTime    @map("expiry_date") @db.Date
  initialQuantity  Int         @map("initial_quantity")
  currentQuantity  Int         @map("current_quantity")
  status           BatchStatus @default(ACTIVE)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  variant    ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productVariantId, batchNumber])
  // FIFO selection: oldest-expiring batches of a variant first
  @@index([productVariantId, expiryDate])
  @@index([expiryDate])
  @@map("product_batch")
}

// The payment token is stored encrypted with pgcrypto (pgp_sym_encrypt); see TokenCipherService.
// Frequency, quantity and discount rules are enforced with CHECK constraints in the migration SQL.
model Subscription {
  id                    String             @id @default(uuid()) @db.Uuid
  customerId            String             @map("customer_id") @db.Uuid
  productVariantId      String             @map("product_variant_id") @db.Uuid
  shippingAddressId     String             @map("shipping_address_id") @db.Uuid
  frequencyDays         Int                @map("frequency_days")
  discountRate          Decimal            @map("discount_rate") @db.Decimal(5, 4)
  quantity              Int                @default(1)
  status                SubscriptionStatus @default(ACTIVE)
  nextBillingDate       DateTime           @map("next_billing_date") @db.Date
  paymentTokenEncrypted Bytes              @map("payment_token_encrypted")
  paymentGateway        PaymentGateway     @map("payment_gateway")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  cancelledAt           DateTime?          @map("cancelled_at")

  customer        Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  variant         ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  shippingAddress Address        @relation(fields: [shippingAddressId], references: [id], onDelete: Restrict)
  payments        Payment[]

  // The daily billing job selects due ACTIVE subscriptions
  @@index([status, nextBillingDate])
  @@index([customerId])
  @@map("subscription")
}

model CartItem {
  id               String   @id @default(uuid()) @db.Uuid
  customerId       String   @map("customer_id") @db.Uuid
  productVariantId String   @map("product_variant_id") @db.Uuid
  quantity         Int
  addedAt          DateTime @default(now()) @map("added_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([customerId, productVariantId])
  @@index([customerId])
  @@map("cart_item")
}

model Order {
  id                String        @id @default(uuid()) @db.Uuid
  customerId        String        @map("customer_id") @db.Uuid
  shippingAddressId String        @map("shipping_address_id") @db.Uuid
  status            OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus     PaymentStatus @default(PENDING) @map("payment_status")
  totalAmount       Decimal       @map("total_amount") @db.Decimal(12, 2)
  totalWeight       Decimal       @map("total_weight") @db.Decimal(12, 2)
  shippingFee       Decimal       @map("shipping_fee") @db.Decimal(12, 2)
  currency          String        @default("LKR") @db.Char(3)
  placedAt          DateTime      @default(now()) @map("placed_at")
  shippedAt         DateTime?     @map("shipped_at")
  deliveredAt       DateTime?     @map("delivered_at")
  cancelledAt       DateTime?     @map("cancelled_at")
  notes             String?
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  shippingAddress Address         @relation(fields: [shippingAddressId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  payments        Payment[]
  refundRequests  RefundRequest[]
  reviews         ProductReview[]

  @@index([customerId, placedAt])
  @@index([status])
  @@map("order")
}

model OrderItem {
  id                String  @id @default(uuid()) @db.Uuid
  orderId           String  @map("order_id") @db.Uuid
  productVariantId  String  @map("product_variant_id") @db.Uuid
  batchId           String  @map("batch_id") @db.Uuid
  quantity          Int
  unitPriceSnapshot Decimal @map("unit_price_snapshot") @db.Decimal(12, 2)
  lineTotal         Decimal @map("line_total") @db.Decimal(12, 2)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  batch   ProductBatch   @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_item")
}

model ShippingRate {
  id         String  @id @default(uuid()) @db.Uuid
  minWeightG Int     @map("min_weight_g")
  maxWeightG Int     @map("max_weight_g")
  feeLkr     Decimal @map("fee_lkr") @db.Decimal(12, 2)
  label      String

  @@unique([minWeightG, maxWeightG])
  @@map("shipping_rate")
}

model Payment {
  id               String         @id @default(uuid()) @db.Uuid
  orderId          String?        @map("order_id") @db.Uuid
  subscriptionId   String?        @map("subscription_id") @db.Uuid
  gateway          PaymentGateway
  gatewayPaymentId String         @unique @map("gateway_payment_id")
  amount           Decimal        @db.Decimal(12, 2)
  currency         String         @default("LKR") @db.Char(3)
  status           PaymentStatus  @default(PENDING)
  rawPayload       Json?          @map("raw_payload")
  processedAt      DateTime?      @map("processed_at")
  createdAt        DateTime       @default(now()) @map("created_at")

  order        Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([subscriptionId])
  @@map("payment")
}

model RefundRequest {
  id                 String       @id @default(uuid()) @db.Uuid
  orderId            String       @map("order_id") @db.Uuid
  customerId         String       @map("customer_id") @db.Uuid
  amount             Decimal      @db.Decimal(12, 2)
  reason             String
  status             RefundStatus @default(REQUESTED)
  processedAt        DateTime?    @map("processed_at")
  processedByAdminId String?      @map("processed_by_admin_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([orderId])
  @@map("refund_request")
}

model ProductReview {
  id         String       @id @default(uuid()) @db.Uuid
  customerId String       @map("customer_id") @db.Uuid
  productId  String       @map("product_id") @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  rating     Int
  comment    String
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([customerId, productId])
  @@index([productId, status, createdAt])
  @@index([orderId])
  @@map("product_review")
}

model SupportTicket {
  id         String              @id @default(uuid()) @db.Uuid
  customerId String              @map("customer_id") @db.Uuid
  subject    String              @db.VarChar(160)
  message    String
  status     SupportTicketStatus @default(OPEN)
  resolvedAt DateTime?           @map("resolved_at")
  closedAt   DateTime?           @map("closed_at")
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@map("support_ticket")
}
