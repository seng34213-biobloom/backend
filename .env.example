# Copy to .env and adjust for your machine.

PORT=4000
NODE_ENV=development

# Matches docker-compose.yml
DATABASE_URL=postgresql://biobloom:biobloom_dev@localhost:5433/biobloom?schema=public

# Matches docker-compose.yml
REDIS_URL=redis://localhost:6379

# Dev-only value, at least 32 characters. Use a long random string outside local development.
JWT_SECRET=change-me-to-a-long-random-string
JWT_CUSTOMER_TTL=15d
JWT_STAFF_TTL=8h

# Key for pgcrypto encryption of subscription payment tokens, at least 16 characters (SDS §7.3)
SUBSCRIPTION_TOKEN_ENC_KEY=dev-subscription-key-change-me

# Stripe test keys and webhook signing secret
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# PayHere sandbox credentials and public callback URLs
PAYHERE_MERCHANT_ID=replace_me
PAYHERE_MERCHANT_SECRET=replace_me
PAYHERE_CHECKOUT_URL=https://sandbox.payhere.lk/pay/checkout
PAYHERE_RETURN_URL=http://localhost:3000/checkout/return
PAYHERE_CANCEL_URL=http://localhost:3000/checkout/cancel
PAYHERE_NOTIFY_URL=https://your-public-api.example.com/api/webhooks/payhere
# PayHere Charging API app credentials, used to charge stored subscription tokens
PAYHERE_APP_ID=replace_me
PAYHERE_APP_SECRET=replace_me
PAYHERE_API_URL=https://sandbox.payhere.lk

# Private S3-compatible bucket for quarantined and verified delivery-proof images.
# AWS credentials are resolved through the standard SDK provider chain.
AWS_REGION=us-east-1
UPLOADS_BUCKET=your-private-proof-bucket

# Outgoing email. Defaults match MailHog in docker-compose.yml (web UI on http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@biobloom.local

# Links placed in emails
STOREFRONT_URL=http://localhost:3000
SELLER_PORTAL_URL=http://localhost:3002

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
